# Optional local-only proxy for browser APIs that do not allow the Vite origin.
# Configure the app Base URL as http://localhost:3000/sub2api while developing.
VITE_SUB2API_PROXY_TARGET=

# Channel defaults. Override these for another deployment; existing browser-saved channels are not overwritten.
VITE_DEFAULT_API_BASE_URL=https://ai.rotor1996.top/v1
VITE_API_KEY_GUIDE_URL=https://ai.rotor1996.top/
